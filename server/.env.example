MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/portfolio
PORT=5000

# Comma-separated list of allowed frontend origins (leave empty in local dev)
CLIENT_ORIGIN=https://your-portfolio.vercel.app,http://localhost:5173

# Gmail credentials (use a Gmail App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where contact-form notifications are delivered (defaults to GMAIL_USER)
CONTACT_TO=

# Settings page (/settings) login
# Initial password, seeded into MongoDB (hashed) on server start if none is set yet.
# After that, change it from the Password tab or force it with: npm run seed-password -- "new-password"
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional: secret the keep-alive scheduler must send to GET /api/health/db?token=...
KEEPALIVE_TOKEN=
# Vercel only: Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Logging: LOG_LEVEL=debug|http|info|warn|error, LOG_TO_FILE=false to disable server/logs/*.log
# NODE_ENV=production switches console output to JSON
LOG_LEVEL=
